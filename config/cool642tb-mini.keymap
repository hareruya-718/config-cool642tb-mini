#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE_FAST 3
#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <200>;
    acceleration-exponent = <1>;
};

&mmv_input_listener {
    fast {
        layers = <3>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    macros {
        macro_mac_Clipbord: macro_mac_Clipbord {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &kp LG(NUMBER_4)>;
            label = "MACRO_MAC_CLIPBORD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp W  &kp E  &kp R  &kp T                                                                &kp Y                 &kp U  &kp I      &kp O    &kp P
&lt 2 A  &kp S  &kp D  &kp F  &kp G                 &none                 &kp C_MUTE               &kp H                 &kp J  &lt 5 K    &kp L    &kp ENTER
&kp Z    &kp X  &kp C  &kp V  &kp B                 &kp LG(L)             &kp ESC                  &kp N                 &kp M  &kp COMMA  &kp DOT  &kp BACKSPACE
&to 6    &to 2  &to 4  &to 0  &mt LEFT_CONTROL TAB  &lt 1 LANGUAGE_2      &mt LEFT_ALT LANGUAGE_1  &mt LEFT_SHIFT SPACE                             &tog 5
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM {
            bindings = <
&kp N1        &kp N2            &kp N3          &kp N4           &kp N5                                              &kp N6            &kp N7             &kp N8     &kp N9        &kp N0
&kp GRAVE     &kp MINUS         &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp EQUAL             &none       &none             &kp SLASH         &kp SQT            &kp DOWN   &kp UP_ARROW  &kp SEMICOLON
&kp LEFT_GUI  &kp LS(LEFT_ALT)  &none           &none            &kp NON_US_BACKSLASH  &trans      &trans            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp COMMA  &kp PERIOD    &kp SLASH
&trans        &trans            &trans          &trans           &trans                &trans      &kp LEFT_CONTROL  &kp LEFT_SHIFT                                                &none
            >;
        };

        FUNCTION {
            bindings = <
&kp F1         &kp F2         &kp F3             &kp F4           &kp F5                                       &kp F6  &kp F7                &kp F8                &kp F9                &kp F10
&bt BT_SEL 4   &bt BT_SEL 3   &bt BT_SEL 2       &bt BT_SEL 1     &bt BT_SEL 0   &none                 &none   &none   &kp LS(LC(NUMBER_1))  &kp LS(LC(NUMBER_2))  &kp LS(LC(NUMBER_3))  &kp LS(LC(NUMBER_4))
&bt BT_DISC 4  &bt BT_DISC 3  &bt BT_DISC 2      &bt BT_DISC 1    &bt BT_DISC 0  &trans                &trans  &none   &none                 &none                 &none                 &none
&bt BT_CLR     &trans         &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp LC(LS(M))  &kp LG(NUMBER_4)      &trans  &trans                                                                    &none
            >;
        };

        MOUSE_FAST {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&kp LC(Z)        &kp LC(A)  &kp LC(X)        &kp LC(C)    &kp LC(V)                                      &kp LG(S)             &kp LC(NUMBER_1)  &mkp MB4        &mkp MB5      &kp LC(LS(T))
&kp LC(H)        &kp LG(E)  &mkp MB2         &mkp MB1     &kp LG(V)             &trans      &trans       &kp F2                &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&kp LC(W)        &kp LC(T)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LC(S)             &trans      &trans       &kp LC(LS(I))         &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT
&kp PRINTSCREEN  &trans     &to 4            &to 0        &mt LEFT_CONTROL TAB  &mo 3       &kp LG(TAB)  &mt LEFT_SHIFT SPACE                                                  &tog 5
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        MAC {
            bindings = <
&kp LG(Z)  &kp LG(A)  &kp LG(X)        &kp LG(C)    &kp LG(V)                                     &kp LG(SPACE)         &kp LC(LG(NUMBER_1))  &mkp MB4      &mkp MB5        &kp LS(LG(T))
&kp LG(H)  &kp LG(N)  &mkp MB2         &mkp MB1     &macro_mac_Clipbord  &trans      &trans       &kp RETURN            &mmv MOVE_RIGHT       &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_LEFT
&kp LG(W)  &kp LG(T)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LG(S)            &trans      &trans       &kp LG(LA(I))         &msc SCRL_RIGHT       &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_LEFT
&to 6      &trans     &trans           &to 0        &mt LEFT_GUI TAB     &mo 3       &kp LG(TAB)  &mt LEFT_SHIFT SPACE                                                      &tog 5
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
